<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>GNMC-Timer</AssemblyName>
    <RootNamespace>GnmcTimer</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Product>경남수학문화관 SW체험 타이머</Product>
    <AssemblyTitle>경남수학문화관 SW체험 타이머</AssemblyTitle>
    <Company>경남수학문화관</Company>
    <Version>1.0.0</Version>
    <DebugType>none</DebugType>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <!-- .NET Framework 에서는 System.Net.Http 를 명시적으로 참조해야 한다 -->
  <ItemGroup>
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <!-- timer.html 과 version.txt 를 exe 안에 내장 (인터넷 없이 첫 실행해도 화면이 뜨도록) -->
  <ItemGroup>
    <EmbeddedResource Include="..\timer.html" LogicalName="timer.html" />
    <EmbeddedResource Include="..\version.txt" LogicalName="version.txt" />
  </ItemGroup>

</Project>
